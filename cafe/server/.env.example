PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/coffee_spot?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development
# Set these before npm run seed. Seed never overwrites existing accounts.
SEED_MANAGER_EMAIL=manager@coffeespot.local
SEED_MANAGER_PASSWORD=
SEED_STAFF_EMAIL=staff@coffeespot.local
SEED_STAFF_PASSWORD=
