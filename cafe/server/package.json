{
  "name": "coffee-spot-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "seed": "node seed.js",
    "demo": "node demo.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/unit.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^8.24.5",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "dotenv": "^17.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.3.0",
    "supertest": "^7.1.4"
  }
}
